{
  "type": "object",
  "additionalProperties": false,
  "required": ["problemText", "figures", "modelAnswer", "explanationSteps", "studentWork", "teachingPoints"],
  "properties": {
    "problemText": { "type": "string" },
    "figures": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imagePosition", "region"],
        "properties": {
          "imagePosition": { "type": "integer", "minimum": 1, "maximum": 3 },
          "region": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number", "minimum": 0, "maximum": 1 },
              "height": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "modelAnswer": { "type": "string" },
    "explanationSteps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "studentWork": { "type": "string" },
    "teachingPoints": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }
  }
}
